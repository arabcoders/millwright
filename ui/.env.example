# Backend origin used by the dev proxy for /api/ requests. Include the full
# backend path, e.g. http://127.0.0.1:8000/api
NUXT_API_URL="http://localhost:8000/api/"

# Origin the browser uses for the /api/events WebSocket. Set this to a public
# origin when the API is not reachable from the browser on localhost. An
# http(s) base is accepted and upgraded to ws(s). Leave unset for same-origin.
NUXT_PUBLIC_WSS=""
